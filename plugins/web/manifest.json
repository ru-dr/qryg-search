{
  "id": "web",
  "name": "Web",
  "description": "Search the web, site shortcuts like \"yt lofi\", and opening URLs.",
  "version": "1.0.0",
  "author": "QryG Search",
  "api": 1,
  "type": "js",
  "main": "plugin.js",
  "keyword": "?",
  "position": "bottom",
  "priority": 100,
  "icon": "web-browser-symbolic",
  "completion": false,
  "examples": [
    ["gnome shell", "Search the web"],
    ["yt lofi", "Site shortcuts like yt, gh, w and maps, also without the prefix"],
    ["github.com", "Open a URL"]
  ],
  "settings": [
    {
      "key": "fallback",
      "type": "bool",
      "title": "Search the web row",
      "description": "Offer a web search at the end of every search",
      "gsetting": "feature-web-fallback"
    },
    {
      "key": "engine",
      "type": "string",
      "title": "Search engine",
      "description": "URL with %s for the query",
      "gsetting": "search-engine"
    },
    {
      "key": "shortcuts",
      "type": "strings",
      "title": "Site shortcuts",
      "description": "key|Name|url entries",
      "gsetting": "web-shortcuts"
    }
  ]
}
